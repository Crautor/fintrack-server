datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

model FinancialGoal {
  financialGoalId Int      @id @default(autoincrement())
  userId          String
  value           Float
  limitDate       DateTime
  status          FinancialGoalStatus
  title           String
  description     String?
  icon            Int
}

enum FinancialGoalStatus {
  Aberto
  Em_Andamento
  Expirado
  Concluido
}
