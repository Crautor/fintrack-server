{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Tecnologias Emergentes",
    "description": "Documentação da API criada em sala"
  },
  "servers": [
    {
      "url": "http://localhost:3001/"
    }
  ],
  "paths": {
    "/api/financialGoals/": {
      "get": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "post": {
        "description": "Cria uma nova meta financeira",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinancialGoal"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/api/financialGoals/{id}": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "put": {
        "description": "Atualiza uma meta financeira existente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinancialGoal"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "delete": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FinancialGoal": {
        "type": "object",
        "properties": {
          "financialGoalId": {
            "type": "integer",
            "example": 1,
            "readOnly": true
          },
          "userId": {
            "type": "integer",
            "example": 123
          },
          "value": {
            "type": "number",
            "format": "float",
            "example": 1000.5
          },
          "limitDate": {
            "type": "string",
            "format": "date-time",
            "example": "2025-12-31T23:59:59Z"
          },
          "status": {
            "type": "string",
            "enum": ["Aberto", "Em_Andamento", "Expirado", "Concluido"],
            "example": "Aberto"
          },
          "title": {
            "type": "string",
            "example": "Comprar carro"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Meta para comprar um carro novo até o final do ano."
          }
        },
        "required": ["userId", "value", "limitDate", "status", "title"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
