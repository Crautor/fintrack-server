datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

model Saving {
  savingId          Int      @id @default(autoincrement())
  userId            String
  value             Float
  financialGoalId   Int
  description       String?
  title             String?
}
